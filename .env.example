# Copy to .env and adjust as needed.
# Loaded automatically by pydantic-settings on app startup.

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=music_ai
# POSTGRES_PORT=5432  # uncomment + uncomment ports in docker-compose.yml for host access

# When set, this overrides the individual DB_* values below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/music_ai

# ---- Backend --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=music_ai

# SQLAlchemy connection-pool sizing (Postgres only; ignored by SQLite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

BACKEND_PORT=8000

# ---- Docker compose resource limits --------------------------------------
# Per-container CPU + memory caps. Tune in compose.override.yml for your host.
API_CPUS=2.0
API_MEMORY=1g
WORKER_CPUS=2.0
WORKER_MEMORY=4g

# ---- Storage --------------------------------------------------------------
# STORAGE_DIR is the preferred single root; uploads and outputs are derived
# from it unless UPLOAD_DIR / OUTPUT_DIR are set explicitly.
STORAGE_DIR=./storage
# UPLOAD_DIR=/abs/path/to/uploads
# OUTPUT_DIR=/abs/path/to/outputs
MAX_UPLOAD_BYTES=209715200

# ---- Redis / Celery -------------------------------------------------------
# Redis password — required by docker-compose, ignored by local dev.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=change-me-in-production
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting --------------------------------------------------------
# Set to false to disable the Redis-backed rate-limit middleware (tests/CI).
RATE_LIMIT_ENABLED=true

# ---- WebSocket ------------------------------------------------------------
# Hard cap on concurrent WS progress connections per client IP.
WS_MAX_CONNECTIONS_PER_IP=10
# Maximum lifetime (in seconds) of a single WS progress stream.
WS_MAX_LIFETIME_SECONDS=1800
