# Copy to .env and adjust as needed.
# Loaded automatically by pydantic-settings on app startup.

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=music_ai
# POSTGRES_PORT=5432  # uncomment + uncomment ports in docker-compose.yml for host access

# When set, this overrides the individual DB_* values below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/music_ai

# ---- Backend --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=music_ai

# SQLAlchemy connection-pool sizing (Postgres only; ignored by SQLite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

BACKEND_PORT=8000

# ---- Docker compose resource limits --------------------------------------
# Per-container CPU + memory caps. Tune in compose.override.yml for your host.
API_CPUS=2.0
API_MEMORY=1g

# --- Heavy worker (Demucs / Basic Pitch / ADTOS) ---
WORKER_HEAVY_CPUS=4.0
WORKER_HEAVY_MEMORY=8g
WORKER_HEAVY_RESERVE_CPUS=2.0
WORKER_HEAVY_RESERVE_MEMORY=4g

# --- Light worker (housekeeping) ---
WORKER_LIGHT_CPUS=1.0
WORKER_LIGHT_MEMORY=512m
WORKER_LIGHT_CONCURRENCY=4

# ---- Worker resource tuning (app-level, overrides auto-probe) -------------
# Concurrency: 0 = auto-probe CPU / memory / GPU at startup (recommended).
# Set to a positive integer to override.
WORKER_CONCURRENCY=0
# Per-child RSS ceiling in MiB. Child is recycled *after* the current task
# when this limit is exceeded (Celery worker_max_memory_per_child).
# 0 = disable.
WORKER_MAX_MEMORY_PER_CHILD_MB=3500
# Pre-task memory gate: refuse to start a heavy task if current RSS exceeds
# this value (MiB). 0 = disable.
WORKER_MEMORY_GATE_MB=3000
# Recycle child after N tasks even if RSS stays under the limit.
# 0 = disable (children live forever).
WORKER_MAX_TASKS_PER_CHILD=10

# ---- Device placement for heavy models ------------------------------------
# Valid values: cpu | cuda
DEMUCS_DEVICE=cpu
BASIC_PITCH_DEVICE=cpu
ADT_DEVICE=cpu

# ---- Storage --------------------------------------------------------------
# STORAGE_DIR is the preferred single root; uploads and outputs are derived
# from it unless UPLOAD_DIR / OUTPUT_DIR are set explicitly.
STORAGE_DIR=./storage
# UPLOAD_DIR=/abs/path/to/uploads
# OUTPUT_DIR=/abs/path/to/outputs
MAX_UPLOAD_BYTES=209715200

# --- Storage backend: ``local`` (filesystem) or ``s3`` (object storage) ---
# Switching to ``s3`` decouples the API and worker from a shared volume,
# enabling horizontal scale-out.  Requires boto3 (pip install boto3).
STORAGE_BACKEND=local
# S3 endpoint URL.  Required for MinIO (e.g. http://minio:9000).
# Leave empty for AWS S3.
STORAGE_S3_ENDPOINT_URL=
# S3 credentials.  Leave both empty to use IAM roles (EC2/ECS).
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# S3 bucket name.  Must already exist.
STORAGE_S3_BUCKET=music-ai
# S3 region (ignored by MinIO, required for AWS signature v4).
STORAGE_S3_REGION=us-east-1
# Auto-cleanup: delete completed task files older than N days. 0=disabled.
# When using S3, prefer configuring a bucket lifecycle rule instead.
STORAGE_LIFECYCLE_DAYS=0

# Audio metadata validation --- prevents decompression-bomb attacks.
# Each limit is checked *after* the file is saved to disk (using
# soundfile metadata).  Set to 0 to disable that specific check.
MAX_AUDIO_DURATION_SECONDS=1800
MAX_AUDIO_SAMPLE_RATE=96000
MAX_AUDIO_CHANNELS=8
MAX_AUDIO_PCM_BYTES=1073741824

# ---- Redis / Celery -------------------------------------------------------
# Redis password — required by docker-compose, ignored by local dev.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=change-me-in-production
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting --------------------------------------------------------
# Set to false to disable the Redis-backed rate-limit middleware (tests/CI).
RATE_LIMIT_ENABLED=true

# ---- WebSocket ------------------------------------------------------------
# Hard cap on concurrent WS progress connections per client IP.
WS_MAX_CONNECTIONS_PER_IP=10
# Maximum lifetime (in seconds) of a single WS progress stream.
WS_MAX_LIFETIME_SECONDS=1800
