# Copy to .env and adjust as needed.
# Loaded automatically by pydantic-settings on app startup.

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=music_ai
POSTGRES_PORT=5432

# When set, this overrides the individual DB_* values below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/music_ai

# ---- Backend --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=music_ai

BACKEND_PORT=8000

