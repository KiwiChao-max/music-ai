# Copy to .env and adjust as needed.
# Loaded automatically by pydantic-settings on app startup.

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=music_ai
POSTGRES_PORT=5432

# When set, this overrides the individual DB_* values below.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/music_ai

# ---- Backend --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=music_ai

BACKEND_PORT=8000

# ---- Storage --------------------------------------------------------------
# STORAGE_DIR is the preferred single root; uploads and outputs are derived
# from it unless UPLOAD_DIR / OUTPUT_DIR are set explicitly.
STORAGE_DIR=./storage
# UPLOAD_DIR=/abs/path/to/uploads
# OUTPUT_DIR=/abs/path/to/outputs
MAX_UPLOAD_BYTES=209715200

# ---- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- HTTP -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
